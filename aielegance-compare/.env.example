# Copy to `.env`. Never commit real keys.

OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TITLE=AIElegance
OPENROUTER_REFERER=https://aielegance.com

# JSON array — swap models without a code change.
AIELEGANCE_MODELS=[{"id":"openai/gpt-4o-mini","name":"GPT-4o mini","provider":"OpenAI"},{"id":"anthropic/claude-sonnet-4","name":"Claude Sonnet","provider":"Anthropic"},{"id":"google/gemini-2.5-flash","name":"Gemini Flash","provider":"Google"},{"id":"meta-llama/llama-3.3-70b-instruct","name":"Llama 3.3 70B","provider":"Meta"}]

AIELEGANCE_MAX_PROMPT_CHARS=4000
AIELEGANCE_MAX_OUTPUT_TOKENS=1200
AIELEGANCE_TIMEOUT_MS=45000
AIELEGANCE_RATE_LIMIT=8
AIELEGANCE_RATE_WINDOW_MS=60000

HOST=127.0.0.1
PORT=3001
NODE_ENV=production
