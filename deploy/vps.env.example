# Copy to /var/www/aielegance/.env on the VPS (never commit real .env).
# Use plain ASCII quotes only. Same logical keys as local .env — see root .env.example.

# Public PocketBase URL (browser + SSR). Must match what you bake into the build:
#   NUXT_PUBLIC_POCKETBASE_URL=https://aifilmstud.io/pb npm run deploy
NUXT_PUBLIC_POCKETBASE_URL=https://aifilmstud.io/pb

# Node on the VPS talks to PocketBase here (PB listening on loopback behind nginx /pb).
POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# Superuser for server-side collection access (same as PocketBase /_/ login).
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# OpenRouter (required for script/LLM features and Speech to Text).
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Atlas Cloud — Seedance 2.5 video generation (https://www.atlascloud.ai/console/api-keys)
# ATLASCLOUD_API_KEY=

# Fix Shot / video repair
# VIDEO_REPAIR_DEFAULT_PROVIDER=openrouter
# VIDEO_REPAIR_DEFAULT_MODEL=runway/aleph-2
# VIDEO_REPAIR_MAX_DURATION=30
# VIDEO_REPAIR_MAX_UPLOAD_MB=150
# VIDEO_REPAIR_MAX_CONCURRENT_JOBS=2
# Required for Aleph: public HTTPS origin OpenRouter can fetch source clips from
VIDEO_REPAIR_PUBLIC_BASE_URL=https://aifilmstud.io
# LUMA_API_KEY=
# LUMA_MODIFY_MODEL=ray-2

# Optional — comparable-film posters/ratings on Overview (OMDb). Free tier: http://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=

# Optional
OPENROUTER_REFERER=https://aifilmstud.io
# OPENROUTER_TITLE=AI Film Studio

# Nitro bind (optional; PM2/systemd often set these instead)
# HOST=0.0.0.0
# PORT=3000

# --- One-time: create collections on THIS PocketBase (fixes “creative_projects is missing” on live) ---
# From your Mac, in the cloned repo (not on the VPS). Uses the public API URL nginx proxies to PB.
#
#   POCKETBASE_URL=https://aifilmstud.io/pb \
#   POCKETBASE_ADMIN_EMAIL='(same as PocketBase /_/ superuser)' \
#   POCKETBASE_ADMIN_PASSWORD='...' \
#   npm run setup-db
#
# Or: npm run setup-db:remote -- https://aifilmstud.io/pb
# Idempotent: existing collections are skipped; safe to re-run after deploys.
