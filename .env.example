# Copy to `.env` and fill in real values. `.env` is gitignored.

# PocketBase API (no trailing slash). Browsers use this URL.
NUXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Optional: URL for Nuxt server only when PB is on localhost but public URL is proxied (e.g. /pb).
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# PocketBase superuser (same as login at /_/) — required for server-side project/asset operations.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# OpenRouter — required for script analysis, shot generation, image generation, Speech to Text, and Adapt to Film
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Atlas Cloud — Seedance 2.5 video (https://www.atlascloud.ai/console/api-keys)
# ATLASCLOUD_API_KEY=

# Optional OpenRouter attribution
# OPENROUTER_REFERER=https://aifilmstud.io
# OPENROUTER_TITLE=AI Film Studio

# Optional Adapt to Film model overrides (defaults to OPENROUTER_STORY_MODEL or openai/gpt-4o-mini)
# OPENROUTER_ADAPT_TREATMENT_MODEL=openai/gpt-4o-mini
# OPENROUTER_ADAPT_SCENES_MODEL=openai/gpt-4o-mini
# OPENROUTER_ADAPT_SHOTS_MODEL=openai/gpt-4o-mini
# OPENROUTER_STORY_MODEL=openai/gpt-4o-mini
